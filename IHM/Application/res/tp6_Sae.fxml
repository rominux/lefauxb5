<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ScrollPane?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.control.ToggleButton?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.text.Font?>

<BorderPane maxHeight="-Infinity" maxWidth="-Infinity" minHeight="-Infinity" minWidth="-Infinity" 
            prefHeight="700.0" prefWidth="1000.0" 
            xmlns="http://javafx.com/javafx/21" 
            xmlns:fx="http://javafx.com/fxml/1" 
            fx:controller="ControllerMain">
   
   <left>
      <VBox prefWidth="240.0" spacing="25.0" style="-fx-border-color: #d1d5db; -fx-border-radius: 8; -fx-background-color: #f9fafb; -fx-background-radius: 8;" BorderPane.alignment="CENTER">
         <padding>
            <Insets bottom="20.0" left="15.0" right="15.0" top="20.0" />
         </padding>
         <children>
            <Label alignment="CENTER" maxWidth="1.7976931348623157E308" style="-fx-font-weight: bold; -fx-text-fill: #1f2937; -fx-font-size: 14px;" text="Préférences de voyage" />
            
            <VBox fx:id="vboxCriteres" alignment="CENTER" spacing="15.0" VBox.vgrow="ALWAYS">
               <children>
                  <VBox alignment="CENTER" spacing="10.0" style="-fx-border-color: #9ca3af; -fx-border-width: 1; -fx-padding: 10; -fx-background-color: white; -fx-border-radius: 5;">
                     <children>
                        <Label style="-fx-font-weight: bold; -fx-text-fill: #4b5563;" text="Premier" />
                        <ComboBox fx:id="comboCritere1" prefWidth="150.0" promptText="Choisir..." />
                        <HBox alignment="CENTER" spacing="5.0">
                           <children>
                              <Label text="Max :" />
                              <TextField fx:id="txtMaxCritere1" prefWidth="70.0" />
                              <Label fx:id="lblUnite1" /> 
                           </children>
                        </HBox>
                     </children>
                  </VBox>
                  
                  <Label style="-fx-text-fill: #6b7280;" text="Puis ↓" />
                  
                  <VBox alignment="CENTER" spacing="10.0" style="-fx-border-color: #9ca3af; -fx-border-width: 1; -fx-padding: 10; -fx-background-color: white; -fx-border-radius: 5;">
                     <children>
                        <Label style="-fx-font-weight: bold; -fx-text-fill: #4b5563;" text="Deuxième" />
                        <ComboBox fx:id="comboCritere2" prefWidth="150.0" promptText="Choisir..." />
                        <HBox alignment="CENTER" spacing="5.0">
                           <children>
                              <Label text="Max :" />
                              <TextField fx:id="txtMaxCritere2" prefWidth="70.0" />
                              <Label fx:id="lblUnite2" />
                           </children>
                        </HBox>
                     </children>
                  </VBox>

                  <Label style="-fx-text-fill: #6b7280;" text="Puis ↓" />
                  
                  <VBox alignment="CENTER" spacing="10.0" style="-fx-border-color: #9ca3af; -fx-border-width: 1; -fx-padding: 10; -fx-background-color: white; -fx-border-radius: 5;">
                     <children>
                        <Label style="-fx-font-weight: bold; -fx-text-fill: #4b5563;" text="Troisième" />
                        <ComboBox fx:id="comboCritere3" prefWidth="150.0" promptText="Choisir..." />
                        <HBox alignment="CENTER" spacing="5.0">
                           <children>
                              <Label text="Max :" />
                              <TextField fx:id="txtMaxCritere3" prefWidth="70.0" />
                              <Label fx:id="lblUnite3" />
                           </children>
                        </HBox>
                     </children>
                  </VBox>
               </children>
            </VBox>
         </children>
         <BorderPane.margin>
            <Insets bottom="10.0" left="10.0" right="5.0" top="10.0" />
         </BorderPane.margin>
      </VBox>
   </left>

   <center>
      <VBox prefWidth="500.0" spacing="15.0" BorderPane.alignment="CENTER">
         <padding>
            <Insets bottom="15.0" left="15.0" right="15.0" top="15.0" />
         </padding>
         <children>
            <HBox alignment="CENTER" spacing="10.0">
               <children>
                  <ComboBox fx:id="comboDepart" maxWidth="1.7976931348623157E308" promptText="Ville de départ" style="-fx-font-size: 14px;" HBox.hgrow="ALWAYS" />
                  <Button fx:id="btnInverserVilles" mnemonicParsing="false" style="-fx-background-color: #e5e7eb; -fx-cursor: hand;" text="⇄">
                     <font>
                        <Font size="14.0" />
                     </font>
                  </Button>
                  <ComboBox fx:id="comboArrivee" maxWidth="1.7976931348623157E308" promptText="Ville d'arrivée" style="-fx-font-size: 14px;" HBox.hgrow="ALWAYS" />
               </children>
            </HBox>
            
            <HBox spacing="10.0">
               <children>
                  <ToggleButton fx:id="tbBus" maxWidth="1.7976931348623157E308" selected="true" text="🚌 BUS" HBox.hgrow="ALWAYS" />
                  <ToggleButton fx:id="tbTrain" maxWidth="1.7976931348623157E308" selected="true" text="🚆 TRAIN" HBox.hgrow="ALWAYS" />
                  <ToggleButton fx:id="tbAvion" maxWidth="1.7976931348623157E308" selected="true" text="✈ AVION" HBox.hgrow="ALWAYS" />
               </children>
            </HBox>

            <HBox alignment="CENTER" spacing="15.0">
               <children>
                  <Button fx:id="btnRechercher" maxWidth="469.0" mnemonicParsing="false" prefHeight="35.0" prefWidth="469.0" style="-fx-background-color: #2563eb; -fx-text-fill: white; -fx-font-weight: bold; -fx-padding: 8 20;" text="Rechercher des itinéraires" HBox.hgrow="ALWAYS">
                     <font>
                        <Font size="14.0" />
                     </font>
                  </Button>
               </children>
            </HBox>
            
            <Label fx:id="lblErreur" alignment="CENTER" maxWidth="1.7976931348623157E308" style="-fx-text-fill: #dc2626; -fx-font-weight: bold;" text="Aucun voyage n'a été trouvé avec ces limites." visible="false" />
            
            <ScrollPane fitToWidth="true" style="-fx-background-color: transparent;" VBox.vgrow="ALWAYS">
               <content>
                  <VBox fx:id="vboxResultats" spacing="15.0">
                     <padding>
                        <Insets bottom="10.0" left="10.0" right="10.0" top="10.0" />
                     </padding>
                  </VBox>
               </content>
            </ScrollPane>
         </children>
      </VBox>
   </center>

   <right>
      <VBox prefWidth="260.0" spacing="15.0" style="-fx-border-color: #d1d5db; -fx-background-color: #f9fafb;" BorderPane.alignment="CENTER">
         <padding>
            <Insets bottom="15.0" left="15.0" right="15.0" top="15.0" />
         </padding>
         <children>
            <Label alignment="CENTER" maxWidth="1.7976931348623157E308" style="-fx-font-weight: bold; -fx-text-fill: #1f2937; -fx-font-size: 14px;" text="Historique des recherches" />
            
            <ScrollPane fitToWidth="true" style="-fx-background-color: transparent;" VBox.vgrow="ALWAYS">
               <content>
                  <VBox fx:id="vboxHistorique" spacing="10.0">
                     <padding>
                        <Insets bottom="10.0" left="5.0" right="5.0" top="10.0" />
                     </padding>
                  </VBox>
               </content>
            </ScrollPane>
         </children>
         <BorderPane.margin>
            <Insets />
         </BorderPane.margin>
      </VBox>
   </right>

</BorderPane>
